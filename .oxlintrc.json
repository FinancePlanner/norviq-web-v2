{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Profile: "bug-finding max". Every rule in the correctness, suspicious and
	// perf categories, plus the type-aware rules from pedantic that catch real
	// defects. pedantic/style/restriction as whole categories stay off: with
	// everything on this repo reported 57k hits, most of them taste (no-ternary,
	// no-magic-numbers, sort-keys) or mutually exclusive (no-named-export vs
	// SvelteKit's required named exports).
	// Svelte template rules still run in ESLint (eslint.config.js).
	"plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest", "node"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"env": { "browser": true, "node": true, "es2024": true },
	"ignorePatterns": [
		"worker-configuration.d.ts",
		".svelte-kit/**",
		"build/**",
		"storybook-static/**",
		"src/lib/paraglide/**"
	],
	"overrides": [
		// `export {}` is what makes an ambient declaration file a module.
		{ "files": ["**/*.d.ts"], "rules": { "unicorn/require-module-specifiers": "off" } },
		// Command-line scripts report on stdout.
		{ "files": ["scripts/**"], "rules": { "no-console": "off" } }
	],
	"rules": {
		// Type-aware bug rules that oxlint files under pedantic.
		"typescript/only-throw-error": "error",
		"typescript/prefer-promise-reject-errors": "error",
		"typescript/return-await": "error",
		"typescript/no-mixed-enums": "error",
		// Non-type-aware pedantic rules that catch defects rather than style.
		"eqeqeq": ["error", "always", { "null": "ignore" }],
		"array-callback-return": "error",
		"no-self-compare": "error",
		"no-constructor-return": "error",

		"no-unused-vars": [
			"error",
			{ "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
		],

		// BACKLOG. Rules of this profile that the existing code still breaks
		// (count as of 2026-11-17, with --type-aware). They report as warnings so
		// CI stays green while every clean rule above is already enforced. To
		// retire one: fix its hits, then delete the line (category rules) or
		// move it to "error" (pedantic rules). Never add a rule here.
		"typescript/no-unsafe-type-assertion": "warn", // 178
		"typescript/no-deprecated": "warn", // 178
		"typescript/no-base-to-string": "error",
		"typescript/no-unsafe-member-access": "warn", // 90
		// Off: TypeScript already checks return paths. The hits are handlers that end in
		// redirect() or error() (both return never), exhaustive switches, and attachments
		// that return a cleanup only on some paths, which is their contract.
		"typescript/consistent-return": "off",
		// `||` on a string, number or boolean is a deliberate "empty counts as missing"
		// here (form fields, API strings), so only object-typed operands are checked.
		"typescript/prefer-nullish-coalescing": [
			"error",
			{ "ignorePrimitives": { "string": true, "number": true, "boolean": true, "bigint": true } }
		],
		"typescript/no-unnecessary-type-conversion": "warn", // 50
		// Off: every hit already sorts a fresh array (a spread copy or the result of a
		// chain), and toSorted() is newer than the browsers the client bundle supports.
		"unicorn/no-array-sort": "off",
		// Arrow functions are exempt: handlers are defined inside the effect that
		// registers them, next to their one use.
		"unicorn/consistent-function-scoping": ["error", { "checkArrowFunctions": false }],
		"typescript/no-unsafe-assignment": "warn", // 30
		// The golden-file specs assert through these helpers.
		"vitest/expect-expect": [
			"error",
			{ "assertFunctionNames": ["expect", "matchesGolden", "near", "nearAll"] }
		],
		"typescript/no-unsafe-argument": "warn", // 26
		// Off: all 26 hits are sequential by nature (polling, cursor pagination, reading
		// a stream, retrying at a lower quality, batches with a concurrency cap).
		"no-await-in-loop": "off",
		"vitest/require-mock-type-parameters": "error",
		"typescript/require-await": "error",
		"typescript/no-unsafe-call": "warn", // 21
		// expect(value, message) is Vitest's own two-argument form.
		"vitest/valid-expect": ["error", { "maxArgs": 2 }],
		"typescript/no-unsafe-return": "warn", // 18
		"typescript/no-unnecessary-type-assertion": "error",
		// console.log is the stray debugging statement; the levelled calls are the
		// server's logging (the Go handlers' slog.Debug/Info).
		"no-console": ["error", { "allow": ["warn", "error", "info", "debug"] }],
		// A default clause is how the ported Go switches name their fallback member.
		"typescript/switch-exhaustiveness-check": [
			"error",
			{ "considerDefaultExhaustiveForUnions": true }
		],
		"typescript/no-misused-promises": "error",
		// Off: every hit copies on purpose (derived option lists, config arrays), and
		// the alternatives the rule offers mutate the source objects.
		"oxc/no-map-spread": "off",
		"vitest/no-conditional-expect": "error",
		"no-shadow": "error",
		"typescript/restrict-plus-operands": "error",
		// The queue name is a contract with the landing page's inline script.
		"no-underscore-dangle": ["error", { "allow": ["__norviqAnalyticsQueue"] }],
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-misused-spread": "error",
		"typescript/no-floating-promises": "error",
		"promise/always-return": ["error", { "ignoreLastCallback": true }],
		"unicorn/prefer-add-event-listener": "error",
		"typescript/unbound-method": "error",
		"vitest/valid-title": "error",
		"typescript/no-unnecessary-type-parameters": "error",
		"no-fallthrough": "error",
		"unicorn/no-array-reverse": "error",
		// Stylesheets are imported for their side effect.
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
		"no-promise-executor-return": "error",
		"no-new": "error",
		"typescript/restrict-template-expressions": "error",
		"promise/no-promise-in-callback": "error",
		"import/no-named-as-default": "error",
		"import/namespace": "error",
		"no-useless-concat": "error"
	}
}
