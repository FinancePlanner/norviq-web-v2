		"echarts": "^6.1.0",
		"maplibre-gl": "^6.16.0",
		"marked": "^18.1.2",
		"mode-watcher": "^1.1.0",
		"motion": "^14.7.1",
		"openapi-fetch": "^0.17.0",
		"posthog-js": "^1.441.2",
		"svelte-sonner": "^1.2.2",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
