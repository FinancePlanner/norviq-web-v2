{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Norviq web (SvelteKit) on Cloudflare Workers. See docs/DEPLOY.md.
	"name": "norviq-web",
	// Lets CI deploy with only CLOUDFLARE_API_TOKEN (not a secret).
	"account_id": "a1140e077254a0b458a463c8af1247b0",
	"compatibility_date": "2026-10-28",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"workers_dev": true,
	"preview_urls": true,
	// Plain-text settings (same names as norviq-web's env in
	// platform/infra apps/norviq/web/values-production.yaml).
	// Secrets — set with `wrangler secret put <NAME>`, never here:
	//   SESSION_SECRET, PUBLIC_API_TOKEN, REVENUECAT_WEB_API_KEY, EDGE_CLIENT_IP_KEY,
	//   SENTRY_DSN (optional)
	"vars": {
		"GO_ENV": "production",
		"BACKEND_URL": "https://api.norviq.org",
		"PUBLIC_BASE_URL": "https://www.norviq.org",
		"COOKIE_SECURE": "true",
		"SENTRY_ENVIRONMENT": "production",
		"POSTHOG_PROJECT_TOKEN": "phc_qHfAXXGQairNucPjrppE2i9i3bf2Hqvyi3UcG9z7jCNN",
		"POSTHOG_HOST": "https://eu.i.posthog.com"
	},
	"env": {
		// Hosted staging preview: `wrangler deploy --env staging` →
		// norviq-web-staging.<account>.workers.dev. Calls the staging API at
		// api-staging.norviq.org, which only admits requests carrying the
		// edge key (infra apps/norviq/preview-gate). Secrets for this env:
		//   SESSION_SECRET, EDGE_CLIENT_IP_KEY (= norviq-staging edge-client-ip-key),
		//   PUBLIC_API_TOKEN (= staging web-env), PREVIEW_BASIC_AUTH ("user:pass").
		"staging": {
			"name": "norviq-web-staging",
			"workers_dev": true,
			"vars": {
				"GO_ENV": "staging",
				"BACKEND_URL": "https://api-staging.norviq.org",
				"PUBLIC_BASE_URL": "https://norviq-web-staging.fernandocorreia316.workers.dev",
				"COOKIE_SECURE": "true",
				"SENTRY_ENVIRONMENT": "staging",
				"POSTHOG_PROJECT_TOKEN": "",
				"POSTHOG_HOST": ""
			},
			// routes would otherwise be inherited and staging would claim norviq.org.
			"routes": []
		}
	},
	// Production serves norviq.org and www (cutover, step 3 in docs/DEPLOY.md).
	// Rollback: remove these and recreate the two A records → 178.105.244.185.
	"routes": [
		{ "pattern": "www.norviq.org", "custom_domain": true },
		{ "pattern": "norviq.org", "custom_domain": true }
	]
}
